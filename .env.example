# Sao chep file nay thanh ".env" va dien gia tri that. KHONG commit file ".env" that len git.

DEBUG=True
SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (SQLite) - mac dinh dung file db.sqlite3 trong thu muc goc du an,
# khong can cai dat gi them. Chi dien DB_NAME neu muon doi duong dan/ten file khac.
# DB_NAME=db.sqlite3

# Domain email duoc phep dang ky (phan cach boi dau phay)
# @due.udn.vn = Truong Dai hoc Kinh te - Dai hoc Da Nang (DUE), da chot voi nhom
ALLOWED_SIGNUP_EMAIL_DOMAINS=due.udn.vn

# Email - dung Mailtrap (Email Testing sandbox, https://mailtrap.io) de test gui/nhan
# nhu that ma khong gui nham vao hop thu that. Lay Username/Password o tab "SMTP Settings"
# trong inbox Mailtrap. Neu muon xem log ngay tren terminal thay vi Mailtrap, doi
# EMAIL_BACKEND ve django.core.mail.backends.console.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=dien-username-mailtrap
EMAIL_HOST_PASSWORD=dien-password-mailtrap
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EC Forum <no-reply@due.udn.vn>

# Redis / Celery - chua co Redis tren may dev nen mac dinh tat, chay dong bo trong-process.
# Bat USE_REDIS_CACHE=True va cai dat Redis that khi deploy/can hieu nang cao hon.
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS_CACHE=False
CELERY_TASK_ALWAYS_EAGER=True

# Tinh nang nghiep vu dac thu (cau hinh duoc, xem CLAUDE.md muc "Chua xac dinh")
MAX_PINNED_PER_CATEGORY=3
