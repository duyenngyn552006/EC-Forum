# --- django-allauth: field labels ---
msgid "Email"
msgstr "Email"

msgid "Email (again)"
msgstr "Email (nhập lại)"

msgid "Email address"
msgstr "Địa chỉ email"

msgid "Email address confirmation"
msgstr "Xác nhận địa chỉ email"

msgid "Password"
msgstr "Mật khẩu"

msgid "Password (again)"
msgstr "Mật khẩu (nhập lại)"

msgid "New Password"
msgstr "Mật khẩu mới"

msgid "New Password (again)"
msgstr "Mật khẩu mới (nhập lại)"

msgid "Current Password"
msgstr "Mật khẩu hiện tại"

msgid "Remember Me"
msgstr "Ghi nhớ đăng nhập"

msgid "Login"
msgstr "Đăng nhập"

msgid "Code"
msgstr "Mã xác thực"

msgid "Forgot your password?"
msgstr "Quên mật khẩu?"

# --- django-allauth: validation / error messages ---
msgid "A user is already registered with this email address."
msgstr "Email này đã được đăng ký bởi một tài khoản khác."

msgid "Incorrect password."
msgstr "Mật khẩu không đúng."

msgid "Invalid login."
msgstr "Thông tin đăng nhập không hợp lệ."

msgid "Invalid or expired key."
msgstr "Liên kết không hợp lệ hoặc đã hết hạn."

msgid "Too many failed login attempts. Try again later."
msgstr "Đăng nhập sai quá nhiều lần. Vui lòng thử lại sau ít phút."

msgid "The password reset token was invalid."
msgstr "Liên kết khôi phục mật khẩu không hợp lệ."

msgid "The email address and/or password you specified are not correct."
msgstr "Email và/hoặc mật khẩu bạn nhập không đúng."

msgid "The email address is not assigned to any user account."
msgstr "Không có tài khoản nào sử dụng địa chỉ email này."

msgid "This account is currently inactive."
msgstr "Tài khoản này hiện đang bị khóa."

msgid "This email address is already associated with this account."
msgstr "Địa chỉ email này đã được gắn với tài khoản của bạn rồi."

msgid "Too many failed login attempts. Try again later."
msgstr "Đăng nhập sai quá nhiều lần. Vui lòng thử lại sau."

msgid "Be patient, you are sending too many requests."
msgstr "Bạn đang gửi yêu cầu quá nhanh, vui lòng chờ một chút rồi thử lại."

msgid "You must type the same password each time."
msgstr "Mật khẩu nhập lại phải trùng khớp."

msgid "You must type the same email each time."
msgstr "Email nhập lại phải trùng khớp."

msgid "You cannot remove your primary email address."
msgstr "Bạn không thể xóa địa chỉ email chính."

msgid "Your primary email address must be verified."
msgstr "Địa chỉ email chính của bạn cần được xác thực."

msgid "Please type your current password."
msgstr "Vui lòng nhập mật khẩu hiện tại của bạn."

msgid "The new value must be different from the current one."
msgstr "Giá trị mới phải khác với giá trị hiện tại."

msgid "Please select only one."
msgstr "Vui lòng chỉ chọn một."

msgid "You cannot add more than %d email addresses."
msgstr "Bạn không thể thêm quá %d địa chỉ email."

# --- django-simple-captcha ---
msgid "Invalid CAPTCHA"
msgstr "Mã xác nhận (CAPTCHA) không đúng"

